    "dataStructuresAndModels": {
        "coreEntities": {
            "user": {
                "fields": [
                    "id",
                    "username/email",
                    "password (not stored in frontend)",
                    "role (admin, user, etc)",
                    "gst_firm",
                    "nongst_firm",
                    "current_firm_type"
                ],
                "scope": "Authentication and authorization"
            },
            "firm": {
                "fields": [
                    "id",
                    "name",
                    "type (GST or NON_GST)",
                    "gstin",
                    "address",
                    "registration details",
                    "financial_year_settings"
                ],
                "internalRepresentation": {
                    "id": "gst or nongst",
                    "type": "GST or NON_GST",
                    "financialYear": "{start, end, label}"
                }
            },
            "item": {
                "fields": [
                    "id",
                    "itemName",
                    "alias",
                    "barcode",
                    "amount (sale_rate)",
                    "purchase_rate",
                    "mrp_rate",
                    "gst_percent",
                    "discount",
                    "stockCount",
                    "threshold",
                    "type (gst flag)",
                    "categoryId",
                    "brandId",
                    "supplierId"
                ],
                "normalizationFunction": "normalizeItem() in apiUtils"
            },
            "contact": {
                "fields": [
                    "id",
                    "name",
                    "alias",
                    "type",
                    "phone",
                    "whatsapp_number",
                    "email",
                    "address",
                    "city, state, gstin",
                    "is_gst (0 or 1)",
                    "category_id, transport_id, area_id, agent_id, label_id",
                    "bank_name, account_number, ifsc_code",
                    "transport_charge"
                ],
                "normalizationFunction": "normalizeContact() in apiUtils"
            },
            "brand": {
                "fields": [
                    "id",
                    "name",
                    "hsnId",
                    "totalItems",
                    "discount1 {normal, special}",
                    "discount2 {normal, special}"
                ],
                "normalizationFunction": "normalizeBrand() in apiUtils"
            },
            "bill": {
                "fields": [
                    "id",
                    "bill_number",
                    "bill_date",
                    "contactType (party or supplier)",
                    "party (reference to contact)",
                    "items (line items array)",
                    "gstType (1 for GST, 0 for Non-GST)",
                    "deductFromStock",
                    "totalAmount",
                    "gstAmount",
                    "discountAmount",
