    "formHandlingPatterns": {
        "approach": "Mixed - React Hook Form and custom useState hooks",
        "patterns": [
            {
                "type": "Component Level State",
                "example": "Login, AddItem, BillForm",
                "method": "useState for form data, errors, touched states",
                "validation": "Manual or via utility validators",
                "features": [
                    "Real-time field change handlers",
                    "Blur-triggered validation",
                    "Submit validation",
                    "Form reset capabilities",
                    "Type-specific error messages"
                ]
            },
            {
                "type": "Custom useForm Hook",
                "location": "hooks/index.js",
                "details": "useForm(initialValues, validationRules) hook",
                "returns": {
                    "values": "Form field values",
                    "errors": "Validation errors",
                    "touched": "Track which fields user has touched",
                    "handleChange": "Update field value",
                    "handleBlur": "Mark field as touched and validate",
                    "isValid": "Overall form validity"
                }
            },
            {
                "type": "Complex Form Example - BillForm",
                "features": [
                    "Dynamic line items",
                    "Real-time calculations",
                    "Dependent field updates",
                    "Dropdown with pagination and search",
                    "Item history tracking",
                    "Stock availability checking",
                    "Multi-party support (party/supplier differentiation)"
                ]
            }
        ],
        "validators": {
            "location": "utils/index.js",
            "available": [
                "required",
                "email",
                "phone",
                "gst",
                "pan",
                "positive",
                "minLength"
            ]
        },
        "commonPatterns": {
            "fieldReset": "resetForm() function in components",
            "dynamicFields": "Array.map() for line items or repeating groups",
            "conditionalDisplay": "Ternary operators based on form state",
            "asyncValidation": "API calls in useEffect for uniqueness checks",
            "debouncing": "Manual implementation in components"
        }
